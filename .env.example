CAMERA_URL=https://www.skylinewebcams.com/es/webcam/espana/andalucia/cadiz/grazalema.html
# Night Activity
# CAMERA_URL=https://www.skylinewebcams.com/es/webcam/espana/canarias/santa-cruz-de-tenerife/playa-los-cristianos.html
CAPTURE_INTERVAL=5

# YOLOv8
YOLO_MODEL=yolov8s.pt
YOLO_CONF=0.25
YOLO_IMGSZ=960
YOLO_DEVICE=cpu

# Generated local results
RESULTS_ROOT=results/local

# Terrace excluded in Grazalema camera (for yolo calibration)
EVAL_EXCLUDE_ZONE=0,560;490,560;420,860;300,980;0,1030